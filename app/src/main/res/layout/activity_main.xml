<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="24dp">

        <TextView
            android:id="@+id/status_human"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚖️ Analizando Pulso..."
            android:textSize="20sp"
            android:textColor="#FF9800"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡 Esperando DNIe..."
            android:textSize="18sp"
            android:textColor="#9E9E9E"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Acerque su documento al sensor"
            android:textSize="14sp"
            android:textColor="#757575" />

        <!-- BOTÓN DE PODER ELECTORAL -->
        <Button
            android:id="@+id/btn_vote"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:text="EMITIR VOTO 🗳️"
            android:textSize="18sp"
            android:backgroundTint="#CCCCCC"
            android:enabled="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/vote_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Votos en Tangle: 0"
            android:textSize="14sp"
            android:textColor="#3F51B5"
            android:textStyle="italic" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
