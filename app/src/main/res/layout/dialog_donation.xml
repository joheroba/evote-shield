<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <ImageView
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:src="@drawable/logo_qis"
        android:layout_marginBottom="16dp"
        android:scaleType="centerInside" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Gracias por Innovar!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tu apoyo voluntario de S/ 1.00 nos permite seguir escalando esta tecnología para todo el Perú."
        android:textAlignment="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auspiciado por: Quality Informatic Solutions SAC\n15 años equipando al Perú con tecnología de vanguardia."
        android:textAlignment="center"
        android:textSize="12sp"
        android:textStyle="italic"
        android:layout_marginTop="8dp"
        android:textColor="@android:color/darker_gray" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <!-- Espacio para QR Yape -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/qr_yape"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/qr_yape" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YAPE"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Espacio para QR Plin -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/qr_plin"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/qr_plin" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLIN"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IMPORTANTE: Escribe 'DONACIÓN' en el mensaje del envío."
        android:textSize="12sp"
        android:textStyle="italic"
        android:layout_marginTop="16dp"
        android:textColor="@android:color/holo_red_dark" />

</LinearLayout>
